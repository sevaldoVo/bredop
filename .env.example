# --- ВИЛКА backend env (скопируй в .env) ---
VILKA_CORS_ORIGINS=http://localhost:5173
# Пул прокси через запятую (SOCKS5/HTTP), случайный на каждый запрос
VILKA_PROXIES=
# TG-OSINT API (заглушка типа Глаз Бога / tg_stub.py)
VILKA_TG_API_URL=
VILKA_TG_API_KEY=
# Telethon MTProto (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Spider tuning
VILKA_SPIDER_DELAY=1.5
VILKA_SPIDER_MAX_NODES=50

# --- Auth enforcement ---
# Оба имени флага равноценны: код читает VILKA_AUTH_ENFORCED, при его отсутствии — AUTH_ENFORCED.
# 1 = обязательный JWT + списание кредитов; 0 = демо-режим (без токена).
VILKA_AUTH_ENFORCED=0
AUTH_ENFORCED=0

# --- ЭТАП 5: SaaS (auth/billing) ---
VILKA_JWT_SECRET=change-me-openssl-rand-hex-32
# Первый админ: при старте бэкенда создаётся (или пароль ПЕРЕЗАПИСЫВАЕТСЯ, если юзер уже есть —
# защита от захвата роли через раннюю регистрацию). Пустой/дефолтный пароль => админ не трогается.
VILKA_ADMIN_EMAIL=admin@vilka.app
VILKA_ADMIN_PASSWORD=change-me-first-login   # <-- замени на реальный strong-пароль в проде
VILKA_ADMIN_CREDITS=100000                    # баланс, до которого догоняется админ при сбросе пароля
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Прод-БД (PostgreSQL из docker-compose.prod.yml); локалка — sqlite по умолчанию
VILKA_DATABASE_URL=
VILKA_PG_USER=vilka
VILKA_PG_PASSWORD=
VILKA_PG_DB=vilka
