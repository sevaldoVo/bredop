# --- ВИЛКА backend env (скопируй в .env) ---
VILKA_CORS_ORIGINS=http://localhost:5173
# Пул прокси через запятую (SOCKS5/HTTP), случайный на каждый запрос
VILKA_PROXIES=
# TG-OSINT API (заглушка типа Глаз Бога / tg_stub.py)
VILKA_TG_API_URL=
VILKA_TG_API_KEY=
# Telethon MTProto (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Spider tuning
VILKA_SPIDER_DELAY=1.5
VILKA_SPIDER_MAX_NODES=50

# --- ЭТАП 5: SaaS (auth/billing) ---
VILKA_JWT_SECRET=change-me-openssl-rand-hex-32
VILKA_ADMIN_EMAIL=admin@vilka.app
VILKA_ADMIN_PASSWORD=change-me-first-login
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Прод-БД (PostgreSQL из docker-compose.prod.yml); локалка — sqlite по умолчанию
VILKA_DATABASE_URL=
VILKA_PG_USER=vilka
VILKA_PG_PASSWORD=
VILKA_PG_DB=vilka
