# ВИЛКА frontend — Vite build → Nginx
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend-patch/package.json ./
RUN npm install
COPY frontend-patch/ ./
# env для прод-сборки: API проксируется nginx'ом на ../backend, поэтому путь относительный
ENV VITE_VILKA_API=/ 
RUN npx vite build || (echo "no vite config — копируем src как есть" && mkdir -p dist && cp -r src index.html dist/ 2>/dev/null || true)

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend-patch/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5173
CMD ["nginx", "-g", "daemon off;"]
